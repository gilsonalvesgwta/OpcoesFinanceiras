# Copie para .env (desenvolvimento) ou preencha nas variáveis da stack (produção).
# Nunca coloque valores reais neste arquivo.

# Endereço público da plataforma, sem https://
DOMINIO=
# Rede do Traefik na VPS (ex.: WtatechNet)
REDE_TRAEFIK=

# Banco e sessão
SENHA_DO_BANCO=
SEGREDO_DA_SESSAO=

# Primeira conta (superadministrador); a senha inicial é trocada no primeiro acesso
SUPERADMIN_EMAIL=
SUPERADMIN_SENHA_INICIAL=

# Dados de mercado: chave GRATUITA da brapi (brapi.dev, sem cartão). Opções vêm do arquivo público da B3, sem chave.
BRAPI_API_KEY=
# gratuito | startup | pro  (define o ritmo de coleta e o que o sistema oferece)
BRAPI_PLANO=gratuito

# Telegram (opcional até a Fase 4)
TELEGRAM_BOT_TOKEN=

# E-mail para recuperação de senha e convites (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cópias de segurança
HORA_DA_COPIA=03:00
MANTER_DIAS=14
